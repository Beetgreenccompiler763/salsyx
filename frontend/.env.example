# Frontend environment variables. Copy to `.env.local`.
#
# The Next.js dev/prod proxy rewrites `/api/*` to the backend (see
# next.config.mjs). Set API_ORIGIN to wherever the Rust API is reachable.

# Local: cargo run -p salsyx-api (default port 8080)
API_ORIGIN=http://localhost:8080

# Production example (Fly/Railway):
# API_ORIGIN=https://salsyx-api.fly.dev
