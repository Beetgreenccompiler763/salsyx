# -----------------------------------------------------------------------------
# Salsyx backend environment variables.
# Copy to `.env` and fill in. Prefix is `AH_`; nested config uses `__`.
# Example: AH_STORAGE__PROVIDER=r2
# -----------------------------------------------------------------------------

# App
AH_APP__ENV=development

# Server
AH_SERVER__HOST=127.0.0.1
AH_SERVER__PORT=8080
AH_SERVER__ALLOWED_ORIGIN=http://localhost:3000

# Database (Neon free tier Postgres in production)
AH_DATABASE__URL=postgres://salsyx:salsyx@localhost:5432/salsyx
AH_DATABASE__MAX_CONNECTIONS=10
AH_DATABASE__AUTO_MIGRATE=true

# GitHub API — leave token empty for anonymous (60 req/h), set a PAT for 5000/h.
AH_GITHUB__TOKEN=
AH_GITHUB__USER_AGENT=salsyx/0.1 (nothing-open-source-should-disappear)

# Storage
#   local: provider=local, local_root=./data/archives
#   r2:    provider=r2 + the r2_* fields below
AH_STORAGE__PROVIDER=local
AH_STORAGE__LOCAL_ROOT=./data/archives
AH_STORAGE__R2_ENDPOINT=
AH_STORAGE__R2_BUCKET=
AH_STORAGE__R2_ACCOUNT_ID=
AH_STORAGE__R2_ACCESS_KEY_ID=
AH_STORAGE__R2_SECRET_ACCESS_KEY=
AH_STORAGE__R2_PUBLIC_BASE_URL=

# Queue
AH_QUEUE__CAPACITY=1024
AH_QUEUE__WORKER_CONCURRENCY=4
